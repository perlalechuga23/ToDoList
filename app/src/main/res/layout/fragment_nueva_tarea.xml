<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_principal">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <!-- Regresar y título -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="28dp">

                <TextView
                    android:id="@+id/btnRegresarTarea"
                    android:layout_width="40dp"
                    android:layout_height="48dp"
                    android:text=" ‹"
                    android:textSize="42sp"
                    android:textColor="@color/texto_principal"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="           Nueva tarea"
                    android:textColor="@color/texto_secundario"
                    android:textSize="26sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Título de la tarea"
                android:textColor="@color/texto_principal"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etTituloTarea"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Escribe el título"
                android:inputType="textCapSentences"
                android:padding="12dp"
                android:textColor="@color/texto_principal"
                android:textColorHint="@color/texto_secundario"
                android:backgroundTint="@color/texto_secundario"
                android:layout_marginBottom="22dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Descripción"
                android:textColor="@color/texto_principal"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etDescripcionTarea"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:gravity="top"
                android:hint="Describe tu tarea..."
                android:inputType="textMultiLine|textCapSentences"
                android:padding="12dp"
                android:textColor="@color/texto_principal"
                android:textColorHint="@color/texto_secundario"
                android:backgroundTint="@color/texto_secundario"
                android:layout_marginBottom="22dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Prioridad"
                android:textColor="@color/texto_principal"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="10dp"/>

            <RadioGroup
                android:id="@+id/rgPrioridad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="22dp">

                <RadioButton
                    android:id="@+id/rbBaja"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="@color/texto_secundario"
                    android:text="Baja"
                    android:textColor="@color/texto_principal"/>

                <RadioButton
                    android:id="@+id/rbMedia"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="@color/texto_secundario"
                    android:text="Media"
                    android:textColor="@color/texto_principal"/>

                <RadioButton
                    android:id="@+id/rbAlta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="@color/texto_secundario"
                    android:text="Alta"
                    android:textColor="@color/texto_principal"/>

            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Categoría"
                android:textColor="@color/texto_principal"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"/>

            <Spinner
                android:id="@+id/spCategoria"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="@color/texto_secundario"
                android:layout_marginBottom="22dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Estado de la tarea"
                android:textColor="@color/texto_principal"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"/>

            <Spinner
                android:id="@+id/spEstado"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="@color/texto_secundario"
                android:layout_marginBottom="30dp"/>

            <Button
                android:id="@+id/btnGuardarTarea"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="Guardar"
                android:textColor="@color/texto_principal"
                android:textSize="16sp"
                android:backgroundTint="@color/boton_principal"/>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
