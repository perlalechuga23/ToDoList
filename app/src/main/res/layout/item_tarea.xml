<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:background="@color/fondo_tarjeta"
    android:elevation="3dp">

    <TextView
        android:id="@+id/tvEstado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Estado de la tarea"
        android:textColor="@color/texto_secundario"
        android:textSize="14sp"
        android:textStyle="bold"/>

    <Spinner
        android:id="@+id/spEstadoTarea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"/>

    <TextView
        android:id="@+id/tvTituloTarea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Título de la tarea"
        android:textColor="@color/texto_secundario"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="6dp"/>

    <TextView
        android:id="@+id/tvDescripcionTarea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Descripción de la tarea"
        android:textColor="@color/texto_principal"
        android:textSize="15sp"
        android:layout_marginTop="6dp"/>

    <TextView
        android:id="@+id/tvPrioridadTarea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Prioridad: Alta"
        android:textColor="@color/texto_secundario"
        android:textSize="14sp"
        android:layout_marginTop="8dp"/>

    <TextView
        android:id="@+id/tvCategoriaTarea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Categoría: Escuela"
        android:textColor="@color/texto_secundario"
        android:textSize="14sp"
        android:layout_marginTop="4dp"/>

    <Button
        android:id="@+id/btnEditarTarea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Editar tarea"
        android:textColor="@color/texto_principal"
        android:backgroundTint="@color/boton_principal"
        android:layout_marginTop="10dp"/>

    <Button
        android:id="@+id/btnEliminarTarea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Eliminar tarea"
        android:textColor="#FFFFFF"
        android:backgroundTint="#8A4B3A"
        android:layout_marginTop="10dp"/>

</LinearLayout>
