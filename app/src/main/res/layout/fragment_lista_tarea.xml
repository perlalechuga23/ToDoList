<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_principal">

    <LinearLayout
        android:id="@+id/contenidoTareas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Encabezado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnMenu"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="☰"
                android:textColor="@color/texto_secundario"
                android:textSize="26sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Mis tareas"
                android:textColor="@color/texto_secundario"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnConfiguracion"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="⚙"
                android:textColor="@color/texto_secundario"
                android:textSize="25sp" />

        </LinearLayout>

        <!-- Filtros de estado -->
        <HorizontalScrollView
            android:id="@+id/scrollFiltros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none"
            android:fillViewport="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnTodas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Todas"
                    android:textColor="@color/texto_principal"
                    android:backgroundTint="@color/boton_principal" />

                <Button
                    android:id="@+id/btnHoy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Hoy"
                    android:textColor="@color/texto_principal"
                    android:backgroundTint="@color/boton_principal" />

                <Button
                    android:id="@+id/btnPendientes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Pendientes"
                    android:textColor="@color/texto_principal"
                    android:backgroundTint="@color/boton_principal" />

                <Button
                    android:id="@+id/btnEnProgreso"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="En progreso"
                    android:textColor="@color/texto_principal"
                    android:backgroundTint="@color/boton_principal" />

                <Button
                    android:id="@+id/btnCompletadas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Completadas"
                    android:textColor="@color/texto_principal"
                    android:backgroundTint="@color/boton_principal" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Buscador -->
        <EditText
            android:id="@+id/etBuscarTarea"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/texto_secundario"
            android:hint="Buscar tarea..."
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textColor="@color/texto_principal"
            android:textColorHint="@color/texto_secundario"
            android:inputType="text" />

        <!-- Ordenar -->
        <Spinner
            android:id="@+id/spOrdenarTareas"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="@color/texto_secundario" />

        <!-- Categoría -->
        <Spinner
            android:id="@+id/spFiltrarCategoria"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="2dp"
            android:backgroundTint="@color/texto_secundario" />

        <!-- Prioridad -->
        <Spinner
            android:id="@+id/spFiltrarPrioridad"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="2dp"
            android:backgroundTint="@color/texto_secundario" />

        <!-- Lista desplazable de tareas -->
        <ScrollView
            android:id="@+id/scrollListaTareas"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:fillViewport="true"
            android:scrollbars="vertical"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/contenedorListaTareas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="12dp" />

        </ScrollView>

        <!-- Agregar tarea -->
        <Button
            android:id="@+id/btnNuevaTarea"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="end"
            android:layout_marginTop="6dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="+"
            android:textColor="@color/texto_principal"
            android:textSize="32sp"
            android:backgroundTint="@color/boton_principal" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
