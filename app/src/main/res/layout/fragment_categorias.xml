<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_principal"
    android:padding="20dp">

    <!-- Flecha y título -->
    <LinearLayout
        android:id="@+id/filaTituloCategorias"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnRegresarCategorias"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:text="‹"
            android:textSize="42sp"
            android:textColor="@color/texto_principal"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/tvTituloCategorias"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="           Categorías"
            android:textColor="@color/texto_principal"
            android:textSize="28sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <TextView
        android:id="@+id/tvDescripcionCategorias"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Mis categorías"
        android:textColor="@color/texto_secundario"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/filaTituloCategorias"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/contenedorCategorias"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/tvDescripcionCategorias"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@color/fondo_tarjeta"
            android:padding="18dp"
            android:text="📚  Escuela"
            android:textColor="@color/texto_principal"
            android:textSize="18sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@color/fondo_tarjeta"
            android:padding="18dp"
            android:text="💼  Trabajo"
            android:textColor="@color/texto_principal"
            android:textSize="18sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@color/fondo_tarjeta"
            android:padding="18dp"
            android:text="🏠  Personal"
            android:textColor="@color/texto_principal"
            android:textSize="18sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@color/fondo_tarjeta"
            android:padding="18dp"
            android:text="🛒  Compras"
            android:textColor="@color/texto_principal"
            android:textSize="18sp"/>

    </LinearLayout>

    <Button
        android:id="@+id/btnAgregarCategoria"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/boton_principal"
        android:text="+ Agregar categoría"
        android:textColor="@color/texto_principal"
        app:layout_constraintTop_toBottomOf="@id/contenedorCategorias"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
