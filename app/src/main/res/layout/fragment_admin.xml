<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_principal"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/filaTituloAdmin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnRegresarAdmin"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:text="‹"
            android:textSize="42sp"
            android:textColor="@color/texto_principal"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/tvTituloAdmin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Panel de administrador"
            android:textColor="@color/texto_principal"
            android:textSize="21sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/contenedorAdmin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/filaTituloAdmin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/opcionUsuariosAdmin"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="8dp"
            android:background="@color/fondo_tarjeta"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <TextView
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="♙"
                android:textColor="@color/texto_secundario"
                android:textSize="30sp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Usuarios"
                android:textColor="@color/texto_principal"
                android:textSize="17sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="@color/texto_principal"
                android:textSize="30sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/opcionCategoriasAdmin"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="8dp"
            android:background="@color/fondo_tarjeta"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <TextView
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="▤"
                android:textColor="@color/texto_secundario"
                android:textSize="30sp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Categorías"
                android:textColor="@color/texto_principal"
                android:textSize="17sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="@color/texto_principal"
                android:textSize="30sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/opcionConfiguracionAdmin"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="8dp"
            android:background="@color/fondo_tarjeta"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <TextView
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="⚙"
                android:textColor="@color/texto_secundario"
                android:textSize="29sp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Configuración"
                android:textColor="@color/texto_principal"
                android:textSize="17sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="@color/texto_principal"
                android:textSize="30sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/opcionPermisosAdmin"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="8dp"
            android:background="@color/fondo_tarjeta"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <TextView
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="✓"
                android:textColor="@color/texto_secundario"
                android:textSize="30sp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Permisos"
                android:textColor="@color/texto_principal"
                android:textSize="17sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="@color/texto_principal"
                android:textSize="30sp"/>
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>